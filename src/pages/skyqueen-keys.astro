---
import MainGridLayout from "../layouts/MainGridLayout.astro";

const title = "SkyQueen Keys";
const description = "Trang cấu hình bảo mật All-In-One của SkyQueen Logistics";
---

<MainGridLayout title={title} description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-[400px]">
        <div class="card-base z-10 px-6 py-8 md:px-9 md:py-8 relative w-full flex flex-col items-center">
            
            {/* Header section */}
            <div class="w-full text-center mb-8">
                <div class="inline-flex items-center justify-center p-3 rounded-full bg-red-500/10 text-red-500 mb-3 animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-black/90 dark:text-white/90">Thông Tin Cấu Hình Bảo Mật</h1>
                <p class="text-sm text-black/50 dark:text-white/50 mt-1">Trang web này chứa thông tin cấu hình nhạy cảm. Bạn cần nhập mật khẩu giải mã để xem nội dung.</p>
            </div>

            {/* Login / Decrypt Form */}
            <div id="login-container" class="w-full max-w-md bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl p-6 backdrop-blur-md transition-all duration-300">
                <form id="decrypt-form" class="space-y-4">
                    <div>
                        <label for="password-input" class="block text-xs font-semibold uppercase tracking-wider text-black/60 dark:text-white/60 mb-2">
                            Mật khẩu giải mã
                        </label>
                        <div class="relative">
                            <input 
                                type="password" 
                                id="password-input" 
                                placeholder="Nhập mật khẩu..." 
                                class="w-full bg-white dark:bg-black/40 border border-black/15 dark:border-white/15 rounded-xl px-4 py-3 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent transition text-black/90 dark:text-white/90"
                                required
                            />
                            <button 
                                type="button" 
                                id="toggle-password-btn" 
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70 focus:outline-none"
                            >
                                <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div id="error-message" class="text-xs text-red-500 bg-red-500/10 border border-red-500/20 rounded-lg p-3 hidden transition-all">
                        Mật khẩu không chính xác hoặc dữ liệu bị lỗi.
                    </div>

                    <button 
                        type="submit" 
                        id="submit-btn" 
                        class="w-full bg-[var(--primary)] hover:opacity-90 active:opacity-100 text-white font-semibold rounded-xl py-3 text-sm transition-all duration-150 flex items-center justify-center gap-2"
                    >
                        <span>Giải Mã Dữ Liệu</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
                        </svg>
                    </button>
                </form>
            </div>

            {/* Decrypted Content Container (Hidden by default) */}
            <div id="content-container" class="w-full hidden space-y-6 animate-fade-in">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-4">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-emerald-500/20 text-emerald-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-black/90 dark:text-white/90">Giải mã thành công</h3>
                            <p class="text-xs text-black/50 dark:text-white/50">Dữ liệu được giải mã an toàn trên trình duyệt của bạn.</p>
                        </div>
                    </div>
                    <div class="flex gap-2 w-full sm:w-auto">
                        <button 
                            id="copy-btn" 
                            class="flex-1 sm:flex-none btn-regular flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-black/5 dark:bg-white/10 text-black/80 dark:text-white/80 hover:bg-black/10 dark:hover:bg-white/15 transition-all"
                        >
                            <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                            </svg>
                            <span id="copy-text">Sao chép cấu hình</span>
                        </button>
                        <button 
                            id="lock-btn" 
                            class="flex-1 sm:flex-none btn-regular flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-500 transition-all"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            <span>Khóa lại</span>
                        </button>
                    </div>
                </div>

                <div class="relative rounded-xl overflow-hidden border border-black/15 dark:border-white/15 bg-black/5 dark:bg-black/40">
                    <div class="flex items-center justify-between px-4 py-2 border-b border-black/15 dark:border-white/15 bg-black/10 dark:bg-black/60 text-xs font-mono text-black/60 dark:text-white/60">
                        <span>.env.docker</span>
                        <span>Plaintext</span>
                    </div>
                    <pre class="p-4 md:p-6 overflow-x-auto text-xs md:text-sm font-mono text-black/85 dark:text-white/85 leading-relaxed selection:bg-[var(--primary)] selection:text-white"><code id="decrypted-code"></code></pre>
                </div>
            </div>

        </div>
    </div>
</MainGridLayout>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
</style>

<script is:inline>
    // Encrypted keys data payload
    const PAYLOAD = {
        salt: "7fec31cd57415b14fd97f1d9b1dbf319",
        iv: "634234d7e7356822bcb4a4e5",
        ciphertext: "",
        tag: "6a7d21f2778c135d10caf3185413c98d",
        iterations: 100000
    };

    const loginContainer = document.getElementById("login-container");
    const contentContainer = document.getElementById("content-container");
    const decryptForm = document.getElementById("decrypt-form");
    const passwordInput = document.getElementById("password-input");
    const togglePasswordBtn = document.getElementById("toggle-password-btn");
    const eyeIcon = document.getElementById("eye-icon");
    const errorMessage = document.getElementById("error-message");
    const decryptedCode = document.getElementById("decrypted-code");
    const copyBtn = document.getElementById("copy-btn");
    const copyText = document.getElementById("copy-text");
    const copyIcon = document.getElementById("copy-icon");
    const lockBtn = document.getElementById("lock-btn");

    let decryptedTextContent = "";

    // Helper to convert hex to Uint8Array
    function hexToUint8Array(hexString) {
        return new Uint8Array(hexString.match(/.{1,2}/g).map(byte => parseInt(byte, 16)));
    }

    // AES-GCM Decrypt function
    async function decryptData(password, payload) {
        try {
            const salt = hexToUint8Array(payload.salt);
            const iv = hexToUint8Array(payload.iv);
            const ciphertext = hexToUint8Array(payload.ciphertext);
            const tag = hexToUint8Array(payload.tag);
            
            // Web Crypto AES-GCM requires ciphertext and tag to be concatenated
            const encryptedData = new Uint8Array(ciphertext.length + tag.length);
            encryptedData.set(ciphertext);
            encryptedData.set(tag, ciphertext.length);

            const enc = new TextEncoder();
            const passwordKey = await window.crypto.subtle.importKey(
                "raw",
                enc.encode(password),
                "PBKDF2",
                false,
                ["deriveKey"]
            );

            const derivedKey = await window.crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: salt,
                    iterations: payload.iterations,
                    hash: "SHA-256"
                },
                passwordKey,
                { name: "AES-GCM", length: 256 },
                false,
                ["decrypt"]
            );

            const decrypted = await window.crypto.subtle.decrypt(
                {
                    name: "AES-GCM",
                    iv: iv,
                    tagLength: 128
                },
                derivedKey,
                encryptedData
            );

            const dec = new TextDecoder();
            return dec.decode(decrypted);
        } catch (e) {
            console.error("Decryption failed:", e);
            throw new Error("Invalid password");
        }
    }

    // Toggle password visibility
    togglePasswordBtn.addEventListener("click", () => {
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            eyeIcon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            `;
        } else {
            passwordInput.type = "password";
            eyeIcon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            `;
        }
    });

    // Form submit handler
    decryptForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMessage.classList.add("hidden");
        const password = passwordInput.value;

        try {
            const decrypted = await decryptData(password, PAYLOAD);
            decryptedTextContent = decrypted;
            decryptedCode.textContent = decrypted;
            
            // Save in session storage
            sessionStorage.setItem("skyqueen_key_pass", password);

            // Show content
            loginContainer.classList.add("hidden");
            contentContainer.classList.remove("hidden");
        } catch (err) {
            errorMessage.classList.remove("hidden");
            passwordInput.focus();
            passwordInput.select();
        }
    });

    // Check if password already in sessionStorage
    async function checkAutoLogin() {
        const storedPass = sessionStorage.getItem("skyqueen_key_pass");
        if (storedPass) {
            try {
                const decrypted = await decryptData(storedPass, PAYLOAD);
                decryptedTextContent = decrypted;
                decryptedCode.textContent = decrypted;
                loginContainer.classList.add("hidden");
                contentContainer.classList.remove("hidden");
            } catch (err) {
                // If stored password doesn't work, clear it
                sessionStorage.removeItem("skyqueen_key_pass");
            }
        }
    }

    // Copy to clipboard
    copyBtn.addEventListener("click", () => {
        if (!decryptedTextContent) return;
        navigator.clipboard.writeText(decryptedTextContent).then(() => {
            copyText.textContent = "Đã sao chép!";
            copyIcon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            `;
            setTimeout(() => {
                copyText.textContent = "Sao chép cấu hình";
                copyIcon.innerHTML = `
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                `;
            }, 2000);
        });
    });

    // Lock button
    lockBtn.addEventListener("click", () => {
        sessionStorage.removeItem("skyqueen_key_pass");
        passwordInput.value = "";
        decryptedCode.textContent = "";
        decryptedTextContent = "";
        contentContainer.classList.add("hidden");
        loginContainer.classList.remove("hidden");
    });

    // Run check on load
    checkAutoLogin();
</script>
